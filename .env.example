# Copia este fichero como .env y rellena los valores reales.
# .env está gitignoreado y nunca se sube al repositorio.

# Contraseña de root de MySQL (elige la que quieras para el entorno local)
MYSQL_ROOT_PASSWORD=cambia_esta_contraseña

# Nombre de la base de datos (no suele cambiar)
DB_NAME=UxiLibrisDB